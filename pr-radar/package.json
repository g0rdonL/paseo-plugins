{
  "name": "@g0rdonl/paseo-pr-radar",
  "version": "1.3.0-fork.2",
  "type": "module",
  "description": "Fork of @omercnet/paseo-pr-radar that also surfaces PRs where the viewer is assignee or mention, so private-repo activity in orgs surfaces alongside authored/reviewer rows.",
  "license": "MIT",
  "author": "Gordon Lee <gordon.lee@g0rdonL>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/g0rdonL/paseo-plugins.git",
    "directory": "pr-radar"
  },
  "homepage": "https://github.com/g0rdonL/paseo-plugins/tree/fork/pr-radar-mention-assignee/pr-radar#readme",
  "bugs": {
    "url": "https://github.com/g0rdonL/paseo-plugins/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": ">=24"
  },
  "keywords": [
    "paseo",
    "paseo-plugin",
    "pull-requests",
    "coding-agents"
  ],
  "files": [
    "index.client.tsx",
    "index.server.ts",
    "client",
    "server",
    "shared",
    "paseo-plugin.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "biome check .",
    "check:write": "biome check --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.reporter=text --coverage.reporter=lcov --coverage.thresholds.lines=90 --coverage.thresholds.functions=85",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@getpaseo/cli": "catalog:",
    "@getpaseo/client": "catalog:",
    "@getpaseo/plugin": "catalog:",
    "@getpaseo/protocol": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "fflate": "catalog:",
    "react": "catalog:",
    "react-native": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  }
}
